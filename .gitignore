# Build output (the workspace target dir grows to many GB)
/target

# Release artifacts are built by .github/workflows/release.yml, not committed
/dist/*.tar.gz
/dist/*.deb
/dist/*.rpm
/dist/*.AppImage
/dist/*.flatpak
/dist/*.zip
/dist/deb/

# Signing material and local secrets (see AGENTS.md section 5)
*.p12
.env
.env.*

# Editor/OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# A target dir made inside crates/ by a relative CARGO_TARGET_DIR
/crates/target
